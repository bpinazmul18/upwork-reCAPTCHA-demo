# Public key used by the browser to create v3 tokens.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key_here
# Private key used only by the server to verify tokens with Google.
RECAPTCHA_SECRET_KEY=your_secret_key_here
# Optional: reject tokens below this score (Google's typical starting point is 0.5).
RECAPTCHA_MIN_SCORE=0.5
